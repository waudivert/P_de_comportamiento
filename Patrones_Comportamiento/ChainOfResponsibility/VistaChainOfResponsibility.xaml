<UserControl
    x:Class="Patrones_Comportamiento.ChainOfResponsibility.VistaChainOfResponsibility"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer
        Background="#F4F8F5"
        VerticalScrollBarVisibility="Auto">

        <Border
            Background="White"
            CornerRadius="15"
            Margin="25"
            Padding="25">

            <StackPanel>

                <!-- Título -->
                <TextBlock
                    Text="CHAIN OF RESPONSIBILITY"
                    Foreground="#267453"
                    FontWeight="Bold"
                    FontSize="14"/>

                <TextBlock
                    Text="Máquina expendedora"
                    FontSize="25"
                    FontWeight="Bold"
                    Foreground="#173D30"
                    Margin="0,8,0,10"/>

                <TextBlock
                    Text="Selecciona un producto. La solicitud pasará por los dispensadores hasta encontrar el adecuado."
                    Foreground="#66776D"
                    TextWrapping="Wrap"
                    Margin="0,0,0,20"/>

                <!-- Selección -->
                <Border
                    Background="#E5F2E9"
                    CornerRadius="12"
                    Padding="20">

                    <StackPanel>

                        <TextBlock
                            Text="Producto"
                            FontWeight="SemiBold"
                            Margin="0,0,0,10"/>

                        <ComboBox
                            x:Name="CmbProductos"
                            Height="38">

                            <ComboBoxItem Content="Refresco"/>
                            <ComboBoxItem Content="Papas fritas"/>
                            <ComboBoxItem Content="Chocolate"/>
                            <ComboBoxItem Content="Galletas"/>

                        </ComboBox>

                        <Button
                            Content="Dispensar producto"
                            Height="42"
                            Margin="0,20,0,0"
                            Background="#267453"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Click="BtnDispensar_Click"/>

                    </StackPanel>
                </Border>

                <!-- Recorrido -->
                <Border
                    Background="#F4F8F2"
                    BorderBrush="#D6E6DB"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,20,0,0">

                    <StackPanel>

                        <TextBlock
                            Text="RECORRIDO DE LA SOLICITUD"
                            FontWeight="Bold"
                            Foreground="#267453"/>

                        <ListBox
                            x:Name="ListaRecorrido"
                            Height="130"
                            Margin="0,12,0,0"
                            Background="Transparent"
                            BorderThickness="0"/>

                    </StackPanel>
                </Border>

                <!-- Resultado -->
                <Border
                    Background="#E5F2E9"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,18,0,0">

                    <StackPanel>

                        <TextBlock
                            Text="RESULTADO"
                            FontWeight="Bold"
                            Foreground="#267453"/>

                        <TextBlock
                            x:Name="TxtResultado"
                            Text="Selecciona un producto."
                            FontSize="18"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap"
                            Foreground="#173D30"
                            Margin="0,12,0,0"/>

                    </StackPanel>
                </Border>

                <!-- Explicación -->
                <Border
                    Background="#F4F8F2"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,20,0,0">

                    <StackPanel>

                        <TextBlock
                            Text="¿Qué demuestra este patrón?"
                            FontWeight="Bold"
                            Foreground="#173D30"/>

                        <TextBlock
                            Text="Cada dispensador decide si puede atender la solicitud. Si no puede, la transfiere al siguiente elemento de la cadena."
                            TextWrapping="Wrap"
                            Foreground="#65766C"
                            Margin="0,8,0,0"/>

                    </StackPanel>
                </Border>

            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
