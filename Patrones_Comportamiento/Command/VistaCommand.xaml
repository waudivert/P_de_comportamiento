<UserControl
    x:Class="Patrones_Comportamiento.Command.VistaCommand"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinWidth="380">

    <ScrollViewer
        Background="#F4F8F5"
        VerticalScrollBarVisibility="Auto">

        <Border
            Background="White"
            Margin="22"
            Padding="24"
            CornerRadius="15">

            <StackPanel>

                <!-- Título -->

                <TextBlock
                    Text="COMMAND"
                    Foreground="#267453"
                    FontWeight="Bold"
                    FontSize="14"/>

                <TextBlock
                    Text="Sincronización veterinaria"
                    FontWeight="Bold"
                    FontSize="25"
                    Foreground="#173D30"
                    Margin="0,8,0,8"/>

                <TextBlock
                    Text="Registra tratamientos sin conexión y sincronízalos posteriormente."
                    TextWrapping="Wrap"
                    Foreground="#66776D"
                    Margin="0,0,0,20"/>

                <!-- Conexión -->

                <Border
                    Background="#E5F2E9"
                    CornerRadius="10"
                    Padding="16">

                    <StackPanel>

                        <TextBlock
                            Text="ESTADO DE CONEXIÓN"
                            FontWeight="SemiBold"
                            Foreground="#246B50"/>

                        <TextBlock
                            x:Name="TxtConexion"
                            Text="Sin conexión"
                            FontWeight="Bold"
                            FontSize="19"
                            Margin="0,8,0,12"/>

                        <Button
                            Content="Cambiar conexión"
                            Height="38"
                            Background="#246B50"
                            Foreground="White"
                            BorderThickness="0"
                            Click="BtnConexion_Click"/>

                    </StackPanel>
                </Border>

                <!-- Registro -->

                <Border
                    Background="#F4F8F2"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,18,0,0">

                    <StackPanel>

                        <TextBlock
                            Text="Registrar tratamiento"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="#173D30"/>

                        <TextBlock
                            Text="Arete del animal"
                            Margin="0,15,0,6"/>

                        <TextBox
                            x:Name="TxtArete"
                            Text="BOV-025"
                            Height="35"
                            Padding="8,5"/>

                        <TextBlock
                            Text="Tratamiento"
                            Margin="0,14,0,6"/>

                        <ComboBox
                            x:Name="CmbTratamiento"
                            Height="35">

                            <ComboBoxItem Content="Vacunación"/>
                            <ComboBoxItem Content="Desparasitación"/>
                            <ComboBoxItem Content="Aplicación de medicamento"/>

                        </ComboBox>

                        <Button
                            Content="Guardar registro"
                            Background="#246B50"
                            Foreground="White"
                            BorderThickness="0"
                            Height="42"
                            Margin="0,20,0,0"
                            Click="BtnRegistrar_Click"/>

                    </StackPanel>
                </Border>

                <!-- Contadores -->

                <Grid Margin="0,18,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Background="#E5F2E9"
                        Padding="16"
                        CornerRadius="10">

                        <StackPanel>

                            <TextBlock
                                Text="PENDIENTES"
                                Foreground="#246B50"
                                FontWeight="Bold"/>

                            <TextBlock
                                x:Name="TxtPendientes"
                                Text="0"
                                FontSize="28"
                                FontWeight="Bold"/>

                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="2"
                        Background="#E5F2E9"
                        Padding="16"
                        CornerRadius="10">

                        <StackPanel>

                            <TextBlock
                                Text="SINCRONIZADOS"
                                Foreground="#246B50"
                                FontWeight="Bold"/>

                            <TextBlock
                                x:Name="TxtSincronizados"
                                Text="0"
                                FontSize="28"
                                FontWeight="Bold"/>

                        </StackPanel>
                    </Border>

                </Grid>

                <!-- Sincronización -->

                <Button
                    Content="Sincronizar pendientes"
                    Height="42"
                    Background="#246B50"
                    Foreground="White"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Margin="0,18,0,0"
                    Click="BtnSincronizar_Click"/>

                <!-- Listas -->

                <TextBlock
                    Text="Registros pendientes"
                    FontWeight="SemiBold"
                    FontSize="16"
                    Foreground="#173D30"
                    Margin="0,22,0,8"/>

                <ListBox
                    x:Name="ListaPendientes"
                    Height="110"
                    Background="#F4F8F2"
                    BorderBrush="#D6E6DB"/>

                <TextBlock
                    Text="Registros sincronizados"
                    FontWeight="SemiBold"
                    FontSize="16"
                    Foreground="#173D30"
                    Margin="0,18,0,8"/>

                <ListBox
                    x:Name="ListaSincronizados"
                    Height="110"
                    Background="#F4F8F2"
                    BorderBrush="#D6E6DB"/>

                <!-- Mensaje -->

                <Border
                    Background="#E5F2E9"
                    Padding="15"
                    CornerRadius="10"
                    Margin="0,18,0,0">

                    <TextBlock
                        x:Name="TxtMensaje"
                        Text="Puedes guardar registros sin conexión."
                        Foreground="#246B50"
                        TextWrapping="Wrap"/>

                </Border>

            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
