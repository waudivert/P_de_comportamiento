<UserControl
    x:Class="Patrones_Comportamiento.State.VistaState"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer
        Background="#F4F8F5"
        VerticalScrollBarVisibility="Auto">

        <Border
            Background="White"
            CornerRadius="15"
            Margin="25"
            Padding="25">

            <StackPanel>
                <!-- Título -->
                <TextBlock
                    Text="STATE"
                    Foreground="#267453"
                    FontWeight="Bold"
                    FontSize="14"/>

                <TextBlock
                    Text="Ciclo de Vida de una Orden de Compra"
                    FontSize="25"
                    FontWeight="Bold"
                    Foreground="#173D30"
                    Margin="0,8,0,10"/>

                <TextBlock
                    Text="El patrón State permite que un objeto cambie completamente sus respuestas según el estado en que se encuentre. Prueba pulsar los botones en distinto orden para comprobar cómo el estado actual valida y bloquea transiciones inválidas."
                    Foreground="#66776D"
                    TextWrapping="Wrap"
                    Margin="0,0,0,20"/>

                <!-- Indicador Visual del Estado Actual -->
                <Border
                    Background="#E5F2E9"
                    CornerRadius="12"
                    Padding="20">

                    <StackPanel>
                        <TextBlock
                            Text="ESTADO ACTUAL DE LA ORDEN"
                            FontWeight="Bold"
                            Foreground="#267453"
                            FontSize="12"/>

                        <Border
                            x:Name="BordeBadgeEstado"
                            Background="#E2A03F"
                            CornerRadius="8"
                            Padding="14,8"
                            Margin="0,10,0,10"
                            HorizontalAlignment="Left">
                            <TextBlock
                                x:Name="TxtBadgeEstado"
                                Text="1. PENDIENTE DE PAGO"
                                FontWeight="Bold"
                                FontSize="16"
                                Foreground="White"/>
                        </Border>

                        <TextBlock
                            x:Name="TxtDescripcionEstado"
                            Text="El pedido fue registrado en el carrito y espera el abono del cliente."
                            FontSize="14"
                            Foreground="#173D30"
                            Margin="0,0,0,16"/>

                        <!-- Botones de Acción -->
                        <TextBlock
                            Text="ACCIONES DISPONIBLES"
                            FontWeight="Bold"
                            Foreground="#267453"
                            FontSize="12"
                            Margin="0,0,0,8"/>

                        <WrapPanel>
                            <Button
                                Content="💳 Pagar"
                                Width="130"
                                Height="40"
                                Margin="0,0,10,10"
                                Background="#267453"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Click="BtnPagar_Click"/>

                            <Button
                                Content="🚚 Despachar / Enviar"
                                Width="160"
                                Height="40"
                                Margin="0,0,10,10"
                                Background="#267453"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Click="BtnEnviar_Click"/>

                            <Button
                                Content="📦 Marcar Entregado"
                                Width="160"
                                Height="40"
                                Margin="0,0,10,10"
                                Background="#267453"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Click="BtnEntregar_Click"/>

                            <Button
                                Content="❌ Cancelar Pedido"
                                Width="140"
                                Height="40"
                                Margin="0,0,10,10"
                                Background="#B93838"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Click="BtnCancelar_Click"/>

                            <Button
                                Content="🔄 Reiniciar Ejemplo"
                                Width="150"
                                Height="40"
                                Margin="0,0,10,10"
                                Background="#556B60"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Click="BtnReset_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Última Respuesta / Resultado -->
                <Border
                    Background="#F4F8F2"
                    BorderBrush="#D6E6DB"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,20,0,0">

                    <StackPanel>
                        <TextBlock
                            Text="ÚLTIMA RESPUESTA RECIBIDA"
                            FontWeight="Bold"
                            Foreground="#267453"/>

                        <TextBlock
                            x:Name="TxtUltimaRespuesta"
                            Text="Orden creada en espera de pago. Presiona un botón para interactuar."
                            FontSize="15"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap"
                            Foreground="#173D30"
                            Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Historial de Transiciones -->
                <Border
                    Background="#E5F2E9"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,18,0,0">

                    <StackPanel>
                        <TextBlock
                            Text="HISTORIAL DE TRANSICIONES Y RECHAZOS"
                            FontWeight="Bold"
                            Foreground="#267453"/>

                        <ListBox
                            x:Name="ListaHistorial"
                            Height="140"
                            Margin="0,12,0,0"
                            Background="White"
                            BorderBrush="#D6E6DB"
                            BorderThickness="1"/>
                    </StackPanel>
                </Border>

                <!-- Explicación Didáctica -->
                <Border
                    Background="#F4F8F2"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,20,0,0">

                    <StackPanel>
                        <TextBlock
                            Text="¿Por qué es State?"
                            FontWeight="Bold"
                            Foreground="#173D30"/>

                        <TextBlock
                            Text="En lugar de tener una clase 'Pedido' llena de 'if (estado == Pendiente) ... else if (estado == Enviado)...', cada estado es una clase independiente que sabe qué transiciones son legales y cuáles son bloqueadas."
                            TextWrapping="Wrap"
                            Foreground="#65766C"
                            Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
